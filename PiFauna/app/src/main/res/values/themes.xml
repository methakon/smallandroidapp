<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Dark, no-action-bar shell matching the current modern-mystic canvas (#0B0716) so there is
        no white flash before Compose draws its first frame.
    -->
    <style name="Theme.PiFauna" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pifauna_background</item>
        <item name="android:statusBarColor">@color/pifauna_background</item>
        <item name="android:navigationBarColor">@color/pifauna_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

</resources>
