    <string name="timer_continuous_disabled_body">Not offered — every session must end on its own. Unattended playback is the main safety hazard this app is built to avoid.</string>

    <!-- Sound Player Screen -->
    <string name="player_sound_output">SOUND OUTPUT</string>
    <string name="player_time_remaining">Time remaining</string>
    <string name="player_timed_session">Timed sound session</string>
    <string name="player_screen_lock_label">Continue timed playback with screen locked</string>
    <string name="player_screen_lock_subtext_on">Allowed — playback continues until the timer expires or a hazard stop occurs.</string>
    <string name="player_screen_lock_subtext_off">Blocked — turning off the screen or locking the phone will stop playback.</string>
    <string name="player_screen_lock_enabled_heading">If enabled</string>
    <string name="player_screen_lock_enabled_body">A foreground media notification shows a Stop action on the lock screen. The battery, volume, thermal, audio-route and audio-focus limits stay active. Never leave sound unattended around people or animals.</string>
    <string name="player_device_state">DEVICE STATE</string>
    <string name="player_checks_heading">Checks before every start</string>
    <string name="player_not_proven_heading">What this does not prove</string>
    <string name="player_not_proven_body">A selected digital frequency does not establish measured speaker output, repellent effects or chakra-specific physiological effects. Phone speakers vary significantly, especially at high frequencies.</string>

